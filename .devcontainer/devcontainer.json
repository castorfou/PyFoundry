{
    "name": "PyFoundry - Dev Environment",
	"workspaceFolder": "/workspaces/PyFoundry",
	"build": {
		"dockerfile": "Dockerfile"
	},
    "runArgs": [
        "--network=host",
        "--label", "com.centurylinklabs.watchtower.enable=false",
        "--env", "CONTAINER_NAME=vscode-dev-container_PyFoundry"
    ],

    // Variables d'environnement
    "containerEnv": {
        "PROJECT_NAME": "PyFoundry",
        "PROJECT_SLUG": "PyFoundry",
        "GITHUB_USERNAME": "castorfou",
        "PYTHON_VERSION": "3.11",
        "WORKSPACE_FOLDER": "/workspaces/PyFoundry",
        "PYTHONPATH": "/workspaces/PyFoundry/src",
        "UV_VENV_CLEAR": "1",
        "UV_LINK_MODE": "copy",
        "UV_PYTHON": "/tmp/venv/bin/python",
        "UV_PROJECT_ENVIRONMENT": "/tmp/venv",
        "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1"
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-toolsai.jupyter",
                "ms-toolsai.vscode-jupyter-cell-tags",
                "ms-toolsai.jupyter-renderers",
                "ms-toolsai.vscode-jupyter-slideshow",
                "ms-toolsai.jupyter-keymap",
                "ms-python.debugpy",
                "ms-python.python",
                "github.vscode-github-actions",
                "mikoz.black-py",
                "mongodb.mongodb-vscode",
                "yzhang.markdown-all-in-one",
                "ukoloff.win-ca",
                "ms-python.vscode-pylance",
                "GitHub.copilot-chat",
                "dbaeumer.vscode-eslint",
                "ms-python.autopep8",
				"xelad0m.jupyter-toc",
                "anthropic.claude-code",
				"catppuccin.catppuccin-vsc-icons",
				"catppuccin.catppuccin-vsc",
				"pomdtr.excalidraw-editor"
            ],
            "settings": {
                // Configuration Python
                "python.defaultInterpreterPath": "/tmp/venv/bin/python",
                "python.venvPath": "/tmp",
                "python.analysis.autoImportCompletions": true,
                "python.analysis.typeCheckingMode": "basic",
				"terminal.integrated.env.linux": {
					"VIRTUAL_ENV": "/tmp/venv",
					"PATH": "/tmp/venv/bin:${env:PATH}"
				},

                // Configuration générale
                "editor.minimap.enabled": true,
                "editor.rulers": [100],

                // Exclusions pour améliorer les performances
                "files.exclude": {
                    "**/__pycache__": true,
                    "**/.pytest_cache": true,
                    "**/node_modules": true,
                    "**/.git": true,
                    "**/.venv": true
                },

                "search.exclude": {
                    "**/__pycache__": true,
                    "**/.venv": true,
                    "**/node_modules": true
                },
                // Désactive l'auto-forward automatique (empêche VS Code de créer des listeners qui peuvent bloquer des ports)
                "remote.autoForwardPorts": false
            }
        }
    },

    // Features devcontainer
    "features": {
        "ghcr.io/va-h/devcontainers-features/uv:1": {},
        "ghcr.io/devcontainers/features/github-cli:1": {},
        "ghcr.io/devcontainers/features/git:1": {
            "ppa": true
        }
    },

    // Montages : HOME persistant propre au projet (survit aux rebuilds), cache pre-commit
    // partagé entre devcontainers, clés SSH, cache uv et timezone de l'hôte (appliquée
    // par setup_timezone : un montage direct sur /etc/localtime écraserait Etc/UTC)
    "mounts": [
        "source=${localEnv:HOME}/.devcontainer/homes/${localWorkspaceFolderBasename}-${devcontainerId},target=/home/vscode,type=bind",
        "source=${localEnv:HOME}/.cache/pre-commit-devcontainers,target=/home/vscode/.cache/pre-commit,type=bind",
        "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,consistency=cached,readonly",
        "source=${localEnv:HOME}/.cache/uv,target=/home/vscode/.cache/uv,type=bind,consistency=cached",
        "source=/etc/localtime,target=/etc/localtime.host,type=bind,consistency=cached,readonly"
    ],

    // Exécuté sur l'hôte avant le montage : crée les sources (sinon Docker les crée en root)
    // puis vérifie chaque montage
    "initializeCommand": "mkdir -p \"${localEnv:HOME}/.devcontainer/homes/${localWorkspaceFolderBasename}-${devcontainerId}/.cache\" \"${localEnv:HOME}/.cache/pre-commit-devcontainers\" \"${localEnv:HOME}/.cache/uv\" && mkdir -p -m 700 \"${localEnv:HOME}/.ssh\" && (cd \"${localWorkspaceFolder}\" && DEVCONTAINER_WORKSPACE_FOLDER_BASENAME=\"${localWorkspaceFolderBasename}\" DEVCONTAINER_ID=\"${devcontainerId}\" bash .devcontainer/scripts/check_mounts.sh --host)",
    // Configuration du shell et de l'environnement
    "postCreateCommand": "bash .devcontainer/postCreateCommand.sh",
    "postStartCommand": "echo '🚀 PyFoundry - Environnement prêt!'",

    // Utilisateur non-root pour la sécurité
    "remoteUser": "vscode",

    // Optimisations de performance
    "shutdownAction": "none"
}
