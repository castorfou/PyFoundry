{
    "name": "{{ cookiecutter.project_name }} - Dev Environment",
    "workspaceFolder": "/workspaces/{{ cookiecutter.project_slug }}",
	"build": {
		"dockerfile": "Dockerfile"
	},
    "runArgs": [
        "--network=host",
        "--label",
        "com.centurylinklabs.watchtower.enable=false",
        "--env",
        "CONTAINER_NAME=vscode-dev-container_{{ cookiecutter.project_slug }}"
    ],
    // Variables d'environnement
    "containerEnv": {
        "PROJECT_NAME": "{{ cookiecutter.project_name }}",
        "PROJECT_SLUG": "{{ cookiecutter.project_slug }}",
        "GITHUB_USERNAME": "{{ cookiecutter.github_username }}",
        "PYTHON_VERSION": "{{ cookiecutter.python_version }}",
        "WORKSPACE_FOLDER": "/workspaces/{{ cookiecutter.project_slug }}",
        "PYTHONPATH": "/workspaces/{{ cookiecutter.project_slug }}/src",
        "UV_VENV_CLEAR": "1",
        "UV_LINK_MODE": "copy",
        "UV_PYTHON": "/tmp/venv/bin/python",
        "UV_PROJECT_ENVIRONMENT": "/tmp/venv",
        "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1",
        // Config Claude Code partagée (montée sur ~/.claude) : y place aussi .claude.json
        "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-toolsai.jupyter",
                "ms-toolsai.vscode-jupyter-cell-tags",
                "ms-toolsai.jupyter-renderers",
                "ms-toolsai.vscode-jupyter-slideshow",
                "ms-toolsai.jupyter-keymap",
                "ms-python.debugpy",
                "ms-python.python",
                "github.vscode-github-actions",
                "mikoz.black-py",
                "mongodb.mongodb-vscode",
                "yzhang.markdown-all-in-one",
                "ukoloff.win-ca",
                "ms-python.vscode-pylance",
                "GitHub.copilot-chat",
                "dbaeumer.vscode-eslint",
                "ms-python.autopep8",
                "xelad0m.jupyter-toc",
                "anthropic.claude-code",
                "catppuccin.catppuccin-vsc-icons",
                "catppuccin.catppuccin-vsc",
                "pomdtr.excalidraw-editor"
            ],
            "settings": {
                // Configuration Python
                "python.defaultInterpreterPath": "/tmp/venv/bin/python",
                "python.venvPath": "/tmp",
                "python.analysis.autoImportCompletions": true,
                "python.analysis.typeCheckingMode": "basic",
                "terminal.integrated.env.linux": {
                    "VIRTUAL_ENV": "/tmp/venv",
                    "PATH": "/tmp/venv/bin:${env:PATH}"
                },
                // Configuration générale
                "editor.minimap.enabled": true,
                "editor.rulers": [
                    100
                ],
                // Exclusions pour améliorer les performances
                "files.exclude": {
                    "**/__pycache__": true,
                    "**/.pytest_cache": true,
                    "**/node_modules": true,
                    "**/.git": true,
                    "**/.venv": true
                },
                "search.exclude": {
                    "**/__pycache__": true,
                    "**/.venv": true,
                    "**/node_modules": true
                },
                // Désactive l'auto-forward automatique (empêche VS Code de créer des listeners qui peuvent bloquer des ports)
                "remote.autoForwardPorts": false
            }
        }
    },
    // Features devcontainer
    "features": {
        "ghcr.io/va-h/devcontainers-features/uv:1": {},
        "ghcr.io/devcontainers/features/github-cli:1": {},
        "ghcr.io/devcontainers/features/git:1": {
            "ppa": true
        }{% if cookiecutter.use_node == "y" %},
        "ghcr.io/devcontainers/features/node:1": {
            "nodeGypDependencies": true,
            "version": "lts",
            "installYarnUsingApt": false
        }{% endif %}{% if cookiecutter.docker_in_docker == "y" %},
        "ghcr.io/devcontainers/features/docker-in-docker:2": {
            "moby": false
        }{% endif %}
    },
    // Montages : HOME persistant propre au projet (survit aux rebuilds), cache pre-commit,
    // authentification gh et config Claude Code partagés entre devcontainers (sauf les verrous IDE,
    // propres au projet), clés SSH, cache uv et timezone de l'hôte (appliquée par setup_timezone :
    // un montage direct sur /etc/localtime écraserait Etc/UTC)
    "mounts": [
        "source=${localEnv:HOME}/.devcontainer/homes/${localWorkspaceFolderBasename}-${devcontainerId},target=/home/vscode,type=bind",
        "source=${localEnv:HOME}/.cache/pre-commit-devcontainers,target=/home/vscode/.cache/pre-commit,type=bind",
        "source=${localEnv:HOME}/.config/gh-devcontainers,target=/home/vscode/.config/gh,type=bind",
        "source=${localEnv:HOME}/.config/claude-devcontainers,target=/home/vscode/.claude,type=bind",
        "source=${localEnv:HOME}/.devcontainer/homes/${localWorkspaceFolderBasename}-${devcontainerId}/.claude-ide,target=/home/vscode/.claude/ide,type=bind",
        "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,consistency=cached,readonly",
        "source=${localEnv:HOME}/.cache/uv,target=/home/vscode/.cache/uv,type=bind,consistency=cached",
        "source=/etc/localtime,target=/etc/localtime.host,type=bind,consistency=cached,readonly"{% if cookiecutter.docker_in_docker == "y" %},
        "source=/var/run/docker.sock,target=/var/run/docker-host.sock,type=bind"{% endif %}
    ],
    // Exécuté sur l'hôte avant le montage : crée les sources et les points de montage imbriqués
    // dans le HOME (sinon Docker les crée en root), recopie l'historique Claude Code de l'ancien
    // HOME du projet, puis vérifie chaque montage
    "initializeCommand": "mkdir -p \"${localEnv:HOME}/.devcontainer/homes/${localWorkspaceFolderBasename}-${devcontainerId}/.ssh\" \"${localEnv:HOME}/.devcontainer/homes/${localWorkspaceFolderBasename}-${devcontainerId}/.cache/pre-commit\" \"${localEnv:HOME}/.devcontainer/homes/${localWorkspaceFolderBasename}-${devcontainerId}/.cache/uv\" \"${localEnv:HOME}/.devcontainer/homes/${localWorkspaceFolderBasename}-${devcontainerId}/.config/gh\" \"${localEnv:HOME}/.devcontainer/homes/${localWorkspaceFolderBasename}-${devcontainerId}/.claude\" \"${localEnv:HOME}/.cache/pre-commit-devcontainers\" \"${localEnv:HOME}/.cache/uv\" && mkdir -p -m 700 \"${localEnv:HOME}/.ssh\" \"${localEnv:HOME}/.config/gh-devcontainers\" \"${localEnv:HOME}/.config/claude-devcontainers\" \"${localEnv:HOME}/.config/claude-devcontainers/ide\" \"${localEnv:HOME}/.devcontainer/homes/${localWorkspaceFolderBasename}-${devcontainerId}/.claude-ide\" && DEVCONTAINER_WORKSPACE_FOLDER_BASENAME=\"${localWorkspaceFolderBasename}\" DEVCONTAINER_ID=\"${devcontainerId}\" bash \"${localWorkspaceFolder}/.devcontainer/scripts/migrate_claude_history.sh\" && (cd \"${localWorkspaceFolder}\" && DEVCONTAINER_WORKSPACE_FOLDER_BASENAME=\"${localWorkspaceFolderBasename}\" DEVCONTAINER_ID=\"${devcontainerId}\" bash .devcontainer/scripts/check_mounts.sh --host)",
    // Configuration du shell et de l'environnement
    "postCreateCommand": "bash .devcontainer/postCreateCommand.sh",
    "postStartCommand": "echo '🚀 {{ cookiecutter.project_name }} - Environnement prêt!'",
    // Utilisateur non-root pour la sécurité
    "remoteUser": "vscode",
    // Optimisations de performance
    "shutdownAction": "none"
}
